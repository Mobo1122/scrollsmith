# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/scrollsmith

# Environment
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production

# Email (Resend)
RESEND_API_KEY=re_your_api_key

# Apple Sign In
APPLE_BUNDLE_ID=com.scrollsmith.app

# YouTube API (optional - youtube-transcript-api doesn't require this)
YOUTUBE_API_KEY=

# Transcription APIs (v1: server-side transcription)
# At least one of these is required for camera roll uploads
OPENAI_API_KEY=sk-your-openai-api-key
ASSEMBLYAI_API_KEY=  # Optional fallback
