import Foundation

/// Centralized configuration for external services.
/// Copy this file to Configuration.swift and fill in your credentials.
/// Configuration.swift is gitignored to protect API keys.
enum Configuration {
    // MARK: - API

    static let apiBaseURL = "https://backend-production-d73a.up.railway.app"

    // MARK: - Sentry (Crash Reporting)
    // Get your DSN from: https://sentry.io → Project Settings → Client Keys

    static let sentryDSN = "YOUR_SENTRY_DSN_HERE"

    // MARK: - Mixpanel (Analytics)
    // Get your token from: https://mixpanel.com → Project Settings → Access Keys

    static let mixpanelToken = "YOUR_MIXPANEL_TOKEN_HERE"

    // MARK: - Environment

    static var isDebug: Bool {
        #if DEBUG
        return true
        #else
        return false
        #endif
    }

    static var environment: String {
        isDebug ? "development" : "production"
    }
}
